# Пример окружения: скопируйте в .env и заполните по своему окружению.
# Файл .env НЕ попадает в git (см. .gitignore).

# Используем localhost что бы локально запускать тесты
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name

# Эти переменные идут в контейнер api
COMPOSE_DATABASE_URL=postgresql+asyncpg://user:password@db_service:5432/db_name
COMPOSE_TEST_DATABASE_URL=postgresql+asyncpg://user:password@db_service:5432/db_name

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# Секрет проверки подписи вебхука (X-Signature = HMAC-SHA256 от тела запроса).
# Пустое значение — проверка подписи отключена (dev-режим).
WEBHOOK_SECRET=
